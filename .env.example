# ---------- База данных ----------
# Асинхронный драйвер: postgresql+asyncpg
DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5432/ne_prosroch

# Отдельные параметры для docker-compose и вспомогательных скриптов.
# POSTGRES_PORT — порт на хосте, на который проброшен контейнер
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ne_prosroch
POSTGRES_USER=ne_prosroch
POSTGRES_PASSWORD=password

# Синхронный URL для Alembic (postgresql+psycopg)
ALEMBIC_DATABASE_URL=postgresql+psycopg://admin:password@localhost:5432/ne_prosroch

# Логировать SQL-запросы
DB_ECHO=false

# ---------- Telegram ----------
# Токен от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Публичный URL mini app (https, доступен извне)
WEBAPP_URL=https://example.com

# ---------- Приложение ----------
API_HOST=0.0.0.0
API_PORT=8000
# Источники для CORS, через запятую
CORS_ORIGINS=http://localhost:5173,https://example.com
LOG_LEVEL=INFO

# ---------- Напоминания и алгоритм ----------
# Часовой пояс для ежедневной проверки
TIMEZONE=Europe/Moscow
# Время ежедневного списания просроченных продуктов, HH:MM.
# Время напоминаний здесь не задаётся: его выбирает пользователь
# в настройках приложения, рассылка проверяется ежечасно
DAILY_CHECK_TIME=09:00
# За сколько дней до истечения срока продукт считается срочным
URGENCY_THRESHOLD_DAYS=3
# Сколько рецептов показывать в рекомендации
MAX_RECOMMENDATIONS=5
